# Privacy policy
TRACEFORGE_REDACTION_MODE=redact
TRACEFORGE_REDACT_PII=true
TRACEFORGE_DETECT_HIGH_ENTROPY=true

# Required only when TRACEFORGE_REDACTION_MODE=tokenize
TRACEFORGE_TOKENIZATION_KEY=replace-with-a-random-secret

# Privacy gateway
TRACEFORGE_LISTEN_ADDRESS=0.0.0.0:4317
TRACEFORGE_HEALTH_ADDRESS=0.0.0.0:8080
TRACEFORGE_UPSTREAM_OTLP_ENDPOINT=127.0.0.1:4319
TRACEFORGE_UPSTREAM_INSECURE=true
TRACEFORGE_MAX_RECEIVE_MIB=16
TRACEFORGE_EXPORT_TIMEOUT_SECONDS=10

# TLS/mTLS for an upstream collector. Use when UPSTREAM_INSECURE=false.
# TRACEFORGE_UPSTREAM_CA_FILE=/run/secrets/ca.pem
# TRACEFORGE_UPSTREAM_CLIENT_CERT_FILE=/run/secrets/client.crt
# TRACEFORGE_UPSTREAM_CLIENT_KEY_FILE=/run/secrets/client.key
