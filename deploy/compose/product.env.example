# Copy this file to a private location and replace the signing key before use.
# Generate a high-entropy value with a password manager or OS CSPRNG.
TRACEFORGE_TENANT_SIGNING_KEY=replace-with-at-least-32-random-bytes

TRACEFORGE_OTLP_PORT=4317
TRACEFORGE_HEALTH_PORT=8080
TRACEFORGE_VIEWER_PORT=8081
TRACEFORGE_CONTROL_PORT=8090

TRACEFORGE_STORE_RETENTION_DAYS=30
TRACEFORGE_MAX_INFLIGHT_EXPORTS=64
TRACEFORGE_ADMISSION_TIMEOUT_SECONDS=0.25
TRACEFORGE_CLIENT_RATE_LIMIT_PER_MINUTE=600
